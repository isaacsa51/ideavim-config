"source ~/.vimrc

"" -- Suggested options --
" Show a few lines of context around the cursor. Note that this makes the
" text scroll if you mouse-click near the start or end of the window.
set scrolloff=5

" Do incremental searching.
set incsearch

"" --- DEFAULT SETTINGS ABOVE ---

Plug 'easymotion/vim-easymotion'
Plug 'preservim/nerdtree'
Plug 'machakann/vim-highlightedyank'

set number relativenumber
set easymotion
set surround

set multiple-cursors
set argtextobj
set commentary
set ignorecase
set smartcase
set hlsearch
""" Needed for which-key pluginset which-key
set which-key
let g:WhichKey_FontSize = 16
" disable the timeout option
set notimeout

let g:argtextobj_pairs="[:],(:),<:>"

""" common settings -------------------------
set showmode
set so=5
set clipboard+=unnamed

let g:WhichKey_ShowVimActions = "true"

set hlsearch
set incsearch

""" Idea specific settings ------------------
set ideajoin

"" Leader key
let mapleader = " "

inoremap jk <esc>

"" Clear search highlights
nnoremap <leader>/ :noh<CR>

"" Navigation
nmap <Leader>j :action PreviousTab<CR>

nmap <Leader>k :action NextTab<CR>
    " Move between splits using arrow keys
nmap <C-Left>  <C-w>h
nmap <C-Right> <C-w>l
nmap <C-Down>  <C-w>j
nmap <C-Up>    <C-w>k

nmap <C-A-Left> <Action>(Back)
nmap <C-A-Right> <Action>(Forward)

""" My Mappings -----------------------------

" Small remapping of existing word navigation to consider camelCase and snake_case words
" to jump between same each case without pressing back
map w [w
map e ]w
map b [b
map ge [b

map <leader>f <Plug>(easymotion-s)
map <leader>e <Plug>(easymotion-f)

map <buffer>gd <Action>(GotoDeclaration)
map <buffer>gy <Action>(GotoTypeDeclaration)
nmap <buffer> gI <Action>(GotoImplementation)
nmap <buffer> gn <Action>(MethodDown)
nmap <buffer> gp <Action>(MethodUp)

" --- Code Actions / Quick Fix ---
let g:WhichKeyDesc_Actions = "<leader>a Quick Fix / Intentions"
nnoremap <leader>a :action ShowIntentionActions<CR>
vnoremap <leader>a :action ShowIntentionActions<CR>

" Searching
let g:WhichKeyDesc_search = "<leader>s Search"
map <leader>se <Action>(SearchEverywhere)
let g:WhichKeyDesc_search = "<leader>sa Everywhere"
map <leader>sr <Action>(RecentFiles)
let g:WhichKeyDesc_search = "<leader>sr Recent Files"
map <leader>su <Action>(FindUsages)
let g:WhichKeyDesc_search = "<leader>su Find Usages"
map <leader>sp <Action>(RecentProjectListGroup)
let g:WhichKeyDesc_search = "<leader>sp Recent Projects"

" Navigation
let g:WhichKeyDesc_navigation = "<leader>n Navigation"
map <leader>ne <Action>(GotoNextError)
let g:WhichKeyDesc_navigation_next_error = "<leader>ne Next Error"
map <leader>no <Action>(NextOccurence)
let g:WhichKeyDesc_navigation_next_occurence = "<leader>no Next Occurrence"
map <leader>ns <Action>(Switcher)
let g:WhichKeyDesc_navigation_switcher = "<leader>nr Recent Files"
map <leader>nr <Action>(RecentFiles)
 et g:WhichKeyDesc_navigation_switcher = "<leader>ns Switcher"
map <leader>nn <Action>(GotoLine)
let g:WhichKeyDesc_navigation_go_to_line = "<leader>nn Go to Line"
" --- Navigation History ---
let g:WhichKeyDesc_Nav_Back = "<leader>n, Go Back"
let g:WhichKeyDesc_Nav_Forward = "<leader>n. Go Forward"

nnoremap <leader>n, :action Back<CR>
nnoremap <leader>n. :action Forward<CR>

" Git
let g:WhichKeyDesc_git = "<leader>g Git"
map <leader>gg <Action>(CheckinProject)
let g:WhichKeyDesc_git_checkin = "<leader>gg Checkin"
map <leader>gc <Action>(Git.Branches)
let g:WhichKeyDesc_git_branches = "<leader>gc Branches"
map <leader>gp <Action>(Git.Commit.And.Push.Executor)
let g:WhichKeyDesc_git_commit_and_push = "<leader>gp Commit & Push"
map <leader>gP <Action>(Vcs.Push)
let g:WhichKeyDesc_git_push = "<leader>gP Push"
map <leader>gm <Action>(VcsGroups)
let g:WhichKeyDesc_git_menu = "<leader>gm Menu"
map <leader>gf <Action>(Git.Fetch)
let g:WhichKeyDesc_git_fetch = "<leader>gf Fetch"
map <leader>ga <Action>(Annotate)
let g:WhichKeyDesc_git_annotate = "<leader>ga Annotate"
map <leader>gl <Action>(ActivateVersionControlToolWindow)
let g:WhichKeyDesc_git_log = "<leader>gl Log"
map <leader>gt <Action>(ActivateCommitToolWindow)
let g:WhichKeyDesc_git_tool = "<leader>gt Tool"

" Gradle
let g:WhichKeyDesc_gradle = "<leader>G Gradle"
" Note: Use :actionlist to see all available actions
" Or use Ctrl+Shift+A in IDE to search for actions and see their IDs
map <leader>Gg <Action>(Android.SyncProject)
let g:WhichKeyDesc_gradle_sync = "<leader>Gg Sync Project"
map <leader>Gs <Action>(ExternalSystem.RefreshAllProjects)
let g:WhichKeyDesc_gradle_sync_all = "<leader>Gs Sync All Projects"
map <leader>Gc <Action>(Gradle.ExecuteTask)
let g:WhichKeyDesc_gradle_execute = "<leader>Gc Execute Task"
map <leader>Gb <Action>(CompileDirty)
let g:WhichKeyDesc_gradle_build = "<leader>Gb Build Dirty"
map <leader>GB <Action>(MakeProject)
let g:WhichKeyDesc_gradle_make = "<leader>GB Make Project"
map <leader>Gr <Action>(Gradle.RefreshDependencies)
let g:WhichKeyDesc_gradle_refresh = "<leader>Gr Refresh Dependencies"
map <leader>GC <Action>(CompileProject)
let g:WhichKeyDesc_gradle_compile = "<leader>GC Compile Project"
map <leader>GR <Action>(Rebuild)
let g:WhichKeyDesc_gradle_rebuild = "<leader>GR Rebuild Project"
map <leader>Gt <Action>(ActivateGradleToolWindow)
let g:WhichKeyDesc_gradle_tool = "<leader>Gt Gradle Tool Window"
map <leader>Gv <Action>(Android.MainMenu.BuildVariants)
let g:WhichKeyDesc_gradle_variants = "<leader>Gv Build Variants"
map <leader>Gl <Action>(Gradle.ShowDaemons)
let g:WhichKeyDesc_gradle_daemons = "<leader>Gl Show Gradle Daemons"

""" Run
let g:WhichKeyDesc_run = "<leader>r Run"
map <leader>rn <Action>(Run)
let g:WhichKeyDesc_run_class = "<leader>rn Run Class"
map <leader>rc <Action>(ChooseRunConfiguration)
let g:WhichKeyDesc_run_choose_configuration = "<leader>rc Run Configuration"
map <leader>rs <Action>(Stop)
let g:WhichKeyDesc_run_stop = "<leader>rs Stop"
map <leader>rr <Action>(Rerun)
let g:WhichKeyDesc_run_rerun = "<leader>rr Rerun"
map <leader>rd <Action>(DebugClass)
let g:WhichKeyDesc_run_debug = "<leader>rd Debug Nearest"
map <leader>rh <Action>(ImportTests)
let g:WhichKeyDesc_run_import_tests = "<leader>rh Test History"
map <leader>rm <Action>(RunMenu)
let g:WhichKeyDesc_run_menu = "<leader>rm Menu"
map <leader>rf <Action>(RerunFailedTests)
let g:WhichKeyDesc_run_failed = "<leader>rf Rerun Failed"

""" Debugging
let g:WhichKeyDesc_debugging = "<leader>d Debugging"
map <leader>dt <Action>(ToggleLineBreakpoint)
let g:WhichKeyDesc_debugging_toggle_breakpoint = "<leader>dt Toggle Break Point"
map <leader>ds <Action>(PhpListenDebugAction)
let g:WhichKeyDesc_debugging_listen = "<leader>ds Start Listening"
map <leader>do <Action>(StepOver)
let g:WhichKeyDesc_debugging_step_over = "<leader>do Step Over"
map <leader>di <Action>(StepInto)
let g:WhichKeyDesc_debugging_step_into = "<leader>di Step Into"
map <leader>dr <Action>(EvaluateExpression)
let g:WhichKeyDesc_debugging_repl = "<leader>dr Repl (Evaluate)"
map <leader>dC <Action>(RunToCursor)
let g:WhichKeyDesc_debugging_run_to_cursor = "<leader>dC Run To Cursor"
map <leader>dc <Action>(Resume)
let g:WhichKeyDesc_debugging_resume = "<leader>dc Resume"

""" Multi-Cursor
let g:WhichKeyDesc_multicursor = "<leader>m Multi-Cursor"
" Add cursor below/above with Vim navigation (j/k)
map <leader>mj <Action>(EditorCloneCaretBelow)
let g:WhichKeyDesc_multicursor_down = "<leader>mj Add Cursor Down (j)"
map <leader>mk <Action>(EditorCloneCaretAbove)
let g:WhichKeyDesc_multicursor_up = "<leader>mk Add Cursor Up (k)"

" Select next/previous occurrence with Vim navigation (n/N)
map <leader>mn <Action>(SelectNextOccurrence)
let g:WhichKeyDesc_multicursor_next = "<leader>mn Select Next Occurrence"
map <leader>mN <Action>(UnselectPreviousOccurrence)
let g:WhichKeyDesc_multicursor_unselect_prev = "<leader>mN Unselect Previous"

" Select all occurrences
map <leader>ma <Action>(SelectAllOccurrences)
let g:WhichKeyDesc_multicursor_all = "<leader>ma Select All Occurrences"

" Add cursor at each line in visual selection
vmap <leader>ml <Action>(EditorAddCaretPerSelectedLine)
let g:WhichKeyDesc_multicursor_per_line = "<leader>ml Cursor Per Line (Visual)"

" Skip occurrence (useful when cycling through)
map <leader>ms <Action>(SkipOccurrence)
let g:WhichKeyDesc_multicursor_skip = "<leader>ms Skip Occurrence"

" Remove all cursors except primary
map <leader>mr <Action>(EditorEscape)
let g:WhichKeyDesc_multicursor_remove = "<leader>mr Remove All Cursors"

" Alternative: Use 'v' prefix for visual/selection-based multi-cursor
let g:WhichKeyDesc_visual_multicursor = "<leader>v Visual Multi-Cursor"
vmap <leader>vj <Action>(EditorCloneCaretBelow)
let g:WhichKeyDesc_visual_multicursor_down = "<leader>vj Add Cursor Down"
vmap <leader>vk <Action>(EditorCloneCaretAbove)
let g:WhichKeyDesc_visual_multicursor_up = "<leader>vk Add Cursor Up"
map <leader>vn <Action>(SelectNextOccurrence)
let g:WhichKeyDesc_visual_multicursor_next = "<leader>vn Select Next Match"
map <leader>va <Action>(SelectAllOccurrences)
let g:WhichKeyDesc_visual_multicursor_all = "<leader>va Select All Matches"

""" Language
let g:WhichKeyDesc_language = "<leader>l Language"
map <leader>lm <Action>(Refactorings.QuickListPopupAction)
let g:WhichKeyDesc_language_menu = "<leader>lm Menu"
map <leader>lr <Action>(RenameElement)
let g:WhichKeyDesc_language_rename = "<leader>lr Rename"
map <leader>lc <Action>(ChangeSignature)
let g:WhichKeyDesc_language_change_signature = "<leader>lc Change Signature"
map <leader>lv <Action>(IntroduceVariable)
let g:WhichKeyDesc_Refactor_Extract = "<leader>lR Extract Method/Function"
vnoremap <leader>lR :action ExtractMethod<CR>
let g:WhichKeyDesc_language_inline = "<leader>li Inline"
map <leader>lf <Action>(ReformatCode)
let g:WhichKeyDesc_language_reformat = "<leader>lf Format"
map <leader>ls <Action>(FileStructurePopup)
let g:WhichKeyDesc_language_file_structure = "<leader>ls File Structure"

""" Tool Windows
let g:WhichKeyDesc_tools = "<leader>t Tools"
map <leader>tr <Action>(ActivateRunToolWindow)
let g:WhichKeyDesc_tools_run = "<leader>tr Run"
map <leader>td <Action>(ActivateDebugToolWindow)
let g:WhichKeyDesc_tools_debug = "<leader>td Debug"
map <leader>tg <Action>(ActivateVersionControlToolWindow)
let g:WhichKeyDesc_tools_todos = "<leader>tT Todo's"
map <leader>tt <Action>(ActivateTerminalToolWindow)
let g:WhichKeyDesc_tools_terminal = "<leader>tt Terminal"
map <leader>tl <Action>(ActivateLogcatToolWindow)
let g:WhichKeyDesc_tools_logcat = "<leader>tl Logcat"

" --- Split Windows Management (<leader>s) ---" Configuramos las descripciones para WhichKey
let g:WhichKeyDesc_Split_Window = "<leader>s Create Split Window"
let g:WhichKeyDesc_Split_Window_v = "<leader>sv Vertical Split (Right)"
let g:WhichKeyDesc_Split_Window_h = "<leader>sh Horizontal Split (Bottom)"
let g:WhichKeyDesc_Split_Window_w = "<leader>sw Close Current Split"
let g:WhichKeyDesc_Split_Window_a = "<leader>sa Close All Other Splits"

" Mapeos para creación de splits usando las acciones nativas de IntelliJ
nnoremap <leader>sv :action SplitVertically<CR>
nnoremap <leader>sh :action SplitHorizontally<CR>

" Mapeos para eliminar splits / cerrar pestañas
nnoremap <leader>sw :action CloseContent<CR>
nnoremap <leader>sa :action CloseAllEditorsButActive<CR>

" --- Navigation between Splits (Alt/Option + keys) ---
" Mapeos solicitados: j=Left, k=Bottom, l=Top, ;=Right
" Usamos <C-w> + dirección que es el estándar de Vim y funciona globalmente en IdeaVim

" Modo Normal
nnoremap <M-j> <C-w>h
nnoremap <M-k> <C-w>j
nnoremap <M-l> <C-w>k
nnoremap <M-;> <C-w>l

" Modo Insert
inoremap <M-j> <Esc><C-w>h
inoremap <M-k> <Esc><C-w>j
inoremap <M-l> <Esc><C-w>k
inoremap <M-;> <Esc><C-w>l

"" NERDTreeNavigation
"" Commands:
""  Ctrl-n  Opens NERDTree window
""  q       Close the NERDTree window
""  o       Open files, directories and bookmarks
""  go      Open selected file, but leave cursor in NERDTree
""  <C-J>
""  <C-K>
""  R       Refresh directories
""  m       Show nerdtree menu
set NERDTree

map <c-n> :NERDTree<CR>

let g:NERDTreeMapActivateNode='j'
let g:NERDTreeMApJumpParent='k'
":NERDTreeFocus
":NERDTreeToggle
":NERDTreeClose
":NERDTreeFind
":NERDTreeRefreshRoot


" -- Map IDE actions to IdeaVim -- https://jb.gg/abva4t
" Map \r to the Reformat Code action
map \r <Action>(ReformatCode)

"" Map <leader>d to start debug
"map <leader>d <Action>(Debug)

"" Map \b to toggle the breakpoint on the current line
"map \b <Action>(ToggleLineBreakpoint)

" Firebender Tab completion mapping
map <Tab> :action com.github.firebender.androidstudiocopilot.autocomplete.edit.AcceptEditCompletionAction<CR>
